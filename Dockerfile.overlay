# Fast rebuild on top of the published v2 image (same Xray core + geo data):
# only the panel code, supervisor config and TZ change.
#   docker build -f Dockerfile.overlay -t derwalldrose/derwalld:v3.5 .
# Full rebuild from scratch: docker build -t derwalldrose/derwalld:v3.5 .
FROM derwalldrose/derwalld:v2
ENV TZ=Asia/Shanghai
COPY app.py ui.html txt_endpoints.py conntrack_stats.py ip_asn.py xray-entrypoint.py /opt/derwalld/
COPY xray-manager.conf /etc/supervisor/conf.d/xray-manager.conf
LABEL org.opencontainers.image.title="derwalld" org.opencontainers.image.version="v3.5"
